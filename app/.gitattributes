# LFS tracking for the KrowdKontrol Unreal project. Scoped to app/ by living here (a
# nested .gitattributes only applies within its own subtree) — set up BEFORE the first
# binary asset lands, per CLAUDE.md's own note and .factory/decisions.md D-003. Do not
# retrofit this after committing binaries without LFS — that needs a history rewrite.

# Unreal's own binary formats
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.upk filter=lfs diff=lfs merge=lfs -text
*.udk filter=lfs diff=lfs merge=lfs -text

# Source art/audio assets (marketplace purchases, Blender exports, etc. — per
# MISSION.md's placeholder-first pipeline, these arrive after the placeholder-art
# phase proves the core loop, not on day one, but the tracking rule should already be
# active when they do)
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Reference images for the future screenshot-regression harness (FACTORY_RULES.md §4
# / .factory/decisions.md D-004) already covered by the *.png rule above — these are
# exactly the kind of binary that bloats a repo fast without LFS.
