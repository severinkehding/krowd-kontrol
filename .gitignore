# secrets
.env
.env.*
!.env.example

# factory stop button (local kill file, never committed)
.factory-stop

# node / bun
node_modules/
bun.lock.local

# python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# harness artifacts
harness/.artifacts/

# OS
.DS_Store

# local Claude Code session runtime state
.claude/scheduled_tasks.lock

# Unreal Engine (app/) — transient/regenerable, never commit. Real content
# (app/Config/, app/Content/, app/Source/, app/*.uproject) is tracked; everything
# below is machine-local build/cache state the engine recreates on open/build.
app/Binaries/
app/Build/
app/DerivedDataCache/
app/Intermediate/
app/Saved/
app/.vs/
app/*.sln
app/*.xcodeproj
app/*.VC.db
app/*.opensdf
app/*.sdf
app/*.opendb
app/*.suo
